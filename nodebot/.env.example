# Max's existing token — same one already in Railway → DISCORD_TOKEN.
DISCORD_TOKEN=

# Max's existing application ID — Discord Developer Portal → your app →
# General Information → Application ID.
CLIENT_ID=

# Your Discord user ID (same as Railway → OWNER_ID). Owner-only commands
# (/voicejoin, /voiceleave) check this.
OWNER_ID=

# Optional, for fast iteration: a test server's ID. Guild-scoped command
# registration shows up instantly instead of waiting ~1hr for global.
# Right-click your server icon → Copy Server ID (Developer Mode: User
# Settings → Advanced). Leave blank to register globally right away.
DEV_GUILD_ID=

# Same OpenRouter key already in Railway → OPENROUTER_API_KEY.
OPENROUTER_API_KEY=

# Optional — defaults to anthropic/claude-3.5-haiku, same as the Python bot.
OPENROUTER_MODEL=

# Speech-to-text (voice): any OpenAI-compatible /audio/transcriptions
# endpoint. Same keys already in Railway. Voice is disabled without this.
TRANSCRIPTION_API_KEY=
# Optional — defaults to OpenAI (https://api.openai.com/v1). Set to
# https://api.groq.com/openai/v1 for Groq's faster/cheaper Whisper.
TRANSCRIPTION_API_URL=
# Optional — defaults to whisper-1.
TRANSCRIPTION_MODEL=

# TTS (voice replies): Fish Audio when set, otherwise falls back to the
# free Microsoft Edge Read Aloud voice automatically.
FISH_API_KEY=
FISH_TTS_MODEL=
FISH_VOICE_ID=

# Fallback defaults, used only until a guild sets its own on the dashboard
# (Settings → Voice). Optional.
#
# Each phrase goes in its own brackets, so a phrase can contain a comma:
#     VOICE_WAKE_WORDS=[hey max] [max, you around?]
# A plain comma-separated list still works for phrases without commas in them.
# Capitals and punctuation are ignored when matching, so what gets stored is
# the tidied-up version.
VOICE_WAKE_WORDS=
VOICE_CANCEL_WORDS=

# Follow-up mode: how long after Max finishes speaking he keeps answering
# without the wake word. Every real answer re-arms it. 0 turns it off.
# Optional — defaults to 25.
VOICE_FOLLOWUP_WINDOW_SEC=

# The two ways to end a follow-up conversation. "stop speaking" cuts him off
# mid-sentence but stays in the conversation; "stop listening" ends it and
# puts the wake word back.
#
# Same bracket form as the wake words. Keep phrases multi-word: matching is
# substring-based, so a bare "stop" would fire inside "stopping".
VOICE_STOP_SPEAKING_WORDS=
VOICE_STOP_LISTENING_WORDS=

# SQLite file for settings/memory/knowledge base. SET THIS TO AN ABSOLUTE
# PATH ON A MOUNTED VOLUME — e.g. DATABASE_PATH=/data/nodebot.db with a
# Railway volume mounted at /data.
#
# It defaults to a RELATIVE path (nodebot.db), which lands on the container's
# own disk. Everything still appears to work, and then every setting you saved
# is gone on the next deploy. The bot warns loudly at startup if this is
# relative; check the first lines of the deploy log for "[db] using ...".
#
# Do NOT point it at the Python bot's bot.db — the bot refuses to start on
# that, because the two schemas share table names but store Discord IDs
# differently. Use migrate-settings.js to bring settings across.
DATABASE_PATH=

# Dashboard login via "Sign in with Discord". Optional — without the secret,
# login stays password-only. Discord Developer Portal → your app → OAuth2:
# copy the Client Secret, and add <your dashboard URL>/api/auth/callback
# under Redirects.
DISCORD_CLIENT_SECRET=

# Public origin of the dashboard, e.g. https://max.up.railway.app. Only needed
# when a reverse proxy rewrites Host; otherwise it's derived per request.
PUBLIC_URL=

# Signs dashboard session cookies. SET THIS — without it a fresh random key is
# generated at startup, so everyone is logged out on every restart and deploy.
SECRET_KEY=

# Password for the dashboard. This is the instance owner's login and is always
# creator level; it stays the break-glass way in if Discord login misbehaves.
DASHBOARD_PASSWORD=
