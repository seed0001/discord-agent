{
  "name": "nodebot",
  "private": true,
  "type": "module",
  "description": "Brand-new Discord bot, built fresh in Node.js — layer by layer.",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --experimental-sqlite src/index.js",
